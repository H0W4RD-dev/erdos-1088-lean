'Erdos1088.erdos_1088' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos1088.erdos_1088 : ∀ n ≥ 3, (fun d => Real.logb 2 ↑(Erdos1088.f d n)) =o[Filter.atTop] fun d => ↑d
def Erdos1088.f : ℕ → ℕ → ℕ :=
fun d n => sInf (Erdos1088.cardSet d n)
def Erdos1088.cardSet : ℕ → ℕ → Set ℕ :=
fun d n =>
  {m | n ≤ m ∧ ∀ (S : Finset (EuclideanSpace ℝ (Fin d))), S.card = m → Erdos1088.HasSubsetWithDistinctDistances n S}
def distinctDistances.{u_1} : {X : Type u_1} → [MetricSpace X] → Finset X → ℕ :=
fun {X} [MetricSpace X] points => (distanceSet points).card
